exports[`renderCards / renderCardList: shared assembly does not change output renderResourcesList (wraps renderCardList) output for the same card set 1`] = `"<div class="resources-list"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-286" aria-label="Open Karl guide: Resources links list"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Resources links list</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-286" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">E1 confirmed</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Open Content and follow: Content → Section title 2 → Subsection.</span><span role="listitem">Choose SF.gov page or External link; external entries carry title, URL, and description.</span></span><span class="karl-guide-path"><strong>Path:</strong> <span>Content → Section title 2 → Subsection</span></span><span class="karl-guide-field"><strong>Field:</strong> <code>resources</code><span class="karl-guide-field-label">Subsection</span></span><span class="karl-guide-rules"><strong>Rules:</strong> <span class="karl-guide-rule">Required: no</span><span class="karl-guide-rule-sep" aria-hidden="true">·</span><span class="karl-guide-rule">repeatable</span><span class="karl-guide-rule-sep" aria-hidden="true">·</span><span class="karl-guide-rule">Subsection (auto-insert) → SF.gov page / External link (shape 3)</span></span></span></span><ul><li><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-287" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-287" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose SF.gov page or External link; external entries carry title, URL, and description.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>External</code></span><button type="button" class="karl-guide-copy" data-karl-copy="External" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An external link.</code></span><button type="button" class="karl-guide-copy" data-karl-copy="An external link." aria-label="Copy Description">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>URL</strong><span class="karl-guide-value-source">visible</span><code>https://example.gov/page</code></span><button type="button" class="karl-guide-copy" data-karl-copy="https://example.gov/page" aria-label="Copy URL">Copy</button></span></span></span></span><a href="https://example.gov/page" target="_blank" rel="noopener noreferrer">External <span class="external-mark" aria-hidden="true">↗</span></a><p>An external link.</p></li><li><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-288" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-288" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose an SF.gov page; Karl supplies the destination title and link.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Internal</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Internal" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An internal link.</code></span><button type="button" class="k