#!/bin/sh
# commit-msg — require the `Claude-Session` trailer on AI-assisted commits.
#
# WHY THIS FILE IS TRACKED AND .git/hooks IS NOT. Hooks under `.git/hooks` are
# per-clone and never committed, so a rule written there exists only on the
# machine that wrote it. This is the real copy; `bun run hooks:install`
# symlinks `.git/hooks/commit-msg` at it.
#
# WHY NOT `core.hooksPath`. That is the usual way to ship tracked hooks, and
# here it would be a SECURITY REGRESSION: it is already set globally to
# ggshield's hook directory, and a repo-local value overrides the global one
# outright, silently disabling the secret scan that runs on pre-push. It is
# not needed either — ggshield's `_dispatch` forwards every hook to
# `$(git rev-parse --git-dir)/hooks/<name>` when that file is executable, so
# a repo-local hook already runs. Leave `core.hooksPath` alone.
#
# THE RULE IS A PAIRING, NOT A BLANKET REQUIREMENT. AGENTS.md asks
# AI-assisted commits to carry BOTH `Co-Authored-By` and `Claude-Session`. A
# human's own commit is not AI-assisted, and a hook demanding the trailer on
# every commit would block ordinary work. The only thing in a message that
# can identify an AI-assisted commit is the `Co-Authored-By` line naming
# Claude, so that is the trigger, and the check runs in both directions:
# either trailer implies the other.
#
# THE KNOWN GAP, stated rather than hidden: a commit carrying NEITHER trailer
# is invisible to this hook. Nothing in the message distinguishes it from a
# human commit, and closing that would mean failing every human commit. The
# hook raises the floor; it is not a proof of provenance.
#
# `git commit --no-verify` bypasses this, as it bypasses every hook. That is
# git's behaviour, not an oversight here.

set -u

msg_file=${1:-}
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# A merge's message is generated by git, not authored, and commit-msg runs
# for it just the same.
[ -e "$git_dir/MERGE_HEAD" ] && exit 0

# Comment lines must go first: git's cleanup runs AFTER this hook, so the
# file still holds the `#` status block. A trailer mentioned in there — or in
# the diff `--verbose` appends — would otherwise read as present.
body=$(sed -e '/^#/d' -e '/^diff --git /,$d' "$msg_file")

# These carry the target commit's trailers, not their own.
case "$body" in
  fixup!* | squash!* | amend!*) exit 0 ;;
esac

coauthor=$(printf '%s\n' "$body" | grep -ciE '^Co-Authored-By:[[:space:]]*.*claude' || true)
session=$(printf '%s\n' "$body" | grep -cE '^Claude-Session:[[:space:]]*[^[:space:]]' || true)
session_any=$(printf '%s\n' "$body" | grep -ciE '^Claude-Session:' || true)

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  An AI-assisted commit in this repo carries BOTH trailers:" >&2
  echo >&2
  echo "    Co-Authored-By: Claude <noreply@anthropic.com>" >&2
  echo "    Claude-Session: <session id or claude.ai/code URL>" >&2
  echo >&2
  echo "  Amend the message to add the missing one, or re-run with" >&2
  echo "  --no-verify if this commit genuinely is not AI-assisted." >&2
  exit 1
}

if [ "$coauthor" -gt 0 ] && [ "$session" -eq 0 ]; then
  if [ "$session_any" -gt 0 ]; then
    fail "Claude-Session: is present but has no value."
  fi
  fail "Co-Authored-By names Claude, but Claude-Session: is missing."
fi

if [ "$session" -gt 0 ] && [ "$coauthor" -eq 0 ]; then
  fail "Claude-Session: is present, but no Co-Authored-By names Claude."
fi

exit 0
