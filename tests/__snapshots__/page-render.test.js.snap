// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renderCards / renderCardList: shared assembly does not change output renderCards output for a representative card set 1`] = `"<div class="cards"><article class="card"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><h3><a href="https://example.gov/page" target="_blank" rel="noopener">External <span aria-hidden="true">↗</span></a></h3><p>An external link.</p></article><article class="card"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Internal</button></h3><p>An internal link.</p></article><article class="card"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><h3><button type="button" class="inline-link" data-render-inert="">Inert</button></h3><p>No target or url at all.</p></article><article class="card"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Unverified</button></h3><p>Needs confirming.<span class="unverified-pill" title="Pending SME review"><span aria-hidden="true">⚠</span> Unverified</span></p></article><article class="card"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><h3><a href="https://example.gov/doc.pdf" target="_blank" rel="noopener">With file badge <span aria-hidden="true">↗</span></a></h3></article></div>"`;

exports[`renderCards / renderCardList: shared assembly does not change output renderResourcesList (wraps renderCardList) output for the same card set 1`] = `"<div class="resources-list"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Body: Resources links</span></span></mark><ul><li><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><a href="https://example.gov/page" target="_blank" rel="noopener noreferrer">External <span class="external-mark" aria-hidden="true">↗</span></a><p>An external link.</p></li><li><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><button type="button" class="inline-link" data-render-target="pestsTopic">Internal</button><p>An internal link.</p></li><li><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><button type="button" class="inline-link" data-render-inert="">Inert</button><p>No target or url at all.</p></li><li><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><button type="button" class="inline-link" data-render-target="pestsTopic">Unverified</button><p>Needs confirming.<span class="unverified-pill" title="Pending SME review"><span aria-hidden="true">⚠</span> Unverified</span></p></li><li><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><a href="https://example.gov/doc.pdf" target="_blank" rel="noopener noreferrer">With file badge <span class="external-mark" aria-hidden="true">↗</span></a><span class="file-badge">PDF</span></li></ul></div>"`;
