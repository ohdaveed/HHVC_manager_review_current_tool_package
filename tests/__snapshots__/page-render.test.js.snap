exports[`renderCards / renderCardList: shared assembly does not change output renderCards output for a representative card set 1`] = `"<div class="cards"><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-270" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-270" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Keep this value in the mockup review record; no verified Karl field is shown.</li><li>Choose SF.gov page or External link; external entries carry title, URL, and description.</li></ol><div class="karl-guide-values"><h4>Copy visible values</h4><div class="karl-guide-value"><div><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>External</code></div><button type="button" class="karl-guide-copy" data-karl-copy="External" aria-label="Copy Title">Copy</button></div><div class="karl-guide-value"><div><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An external link.</code></div><button type="button" class="karl-guide-copy" data-karl-copy="An external link." aria-label="Copy Description">Copy</button></div><div class="karl-guide-value"><div><strong>URL</strong><span class="karl-guide-value-source">visible</span><code>https://example.gov/page</code></div><button type="button" class="karl-guide-copy" data-karl-copy="https://example.gov/page" aria-label="Copy URL">Copy</button></div></div></div></span><h3><a href="https://example.gov/page" target="_blank" rel="noopener">External <span aria-hidden="true">↗</span></a></h3><p>An external link.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-271" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-271" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">E1 confirmed</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Open Content and follow: Content → About.</li><li>Choose an SF.gov page; Karl supplies the destination title and link.</li></ol><p class="karl-guide-path"><strong>Path:</strong> <span>Content → About</span></p><div class="karl-guide-values"><h4>Copy visible values</h4><div class="karl-guide-value"><div><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Internal</code></div><button type="button" class="karl-guide-copy" data-karl-copy="Internal" aria-label="Copy Title">Copy</button></div><div class="karl-guide-value"><div><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An internal link.</code></div><button type="button" class="karl-guide-copy" data-karl-copy="An internal link." aria-label="Copy Description">Copy</button></div><div class="karl-guide-value"><div><strong>SF.gov page key</strong><span class="karl-guide-value-source">visible</span><code>pestsTopic</code></div><button type="button" class="karl-guide-copy" data-karl-copy="pestsTopic" aria-label="Copy SF.gov page key">Copy</button></div></div></div></span><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Internal</button></h3><p>An internal link.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-272" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-272" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">E1 confirmed</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Open Content and follow: Content → About.</li><li>Choose an SF.gov page; Karl supplies the destination title and link.</li></ol><p class="karl-guide-path"><strong>Path:</strong> <span>Content → About</span></p><div class="karl-guide-values"><h4>Copy visible values</h4><div class="karl-guide-value"><div><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Inert</code></div><button type="button" class="karl-guide-copy" data-karl-copy="Inert" aria-label="Copy Title">Copy</button></div><div class="karl-guide-value"><div><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>No target or url at all.</code></div><button type="button" class="karl-guide-copy" data-karl-copy="No target or url at all." aria-label="Copy Description">Copy</button></div></div></div></span><h3><button type="button" class="inline-link" data-render-inert="">Inert</button></h3><p>No target or url at all.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-273" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-273" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">E1 confirmed</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Open Content and follow: Content → About.</li><li>Choose an SF.gov page; Karl supplies the destination title and link.</li></ol><p class="karl-guide-path"><strong>Path:</strong> <span>Content → About</span></p><div class="karl-guide-values"><h4>Copy visible values</h4><div class="karl-guide-value"><div><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Unverified</code></div><button type="button" class="karl-guide-copy" data-karl-copy="Unverified" aria-label="Copy Title">Copy</button></div><div class="karl-guide-value"><div><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>Needs confirming.</code></div><button type="button" class="karl-guide-copy" data-karl-copy="Needs confirming." aria-label="Copy Description">Copy</button></div><div class="karl-guide-value"><div><strong>SF.gov page key</strong><span class="karl-guide-value-source">visible</span><code>pestsTopic</code></div><button type="button" class="karl-guide-copy" data-karl-copy="pestsTopic" aria-label="Copy SF.gov page key">Copy</button></div></div></div></span><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Unverified</button></h3><p>Needs confirming.<span class="unverified-pill" title="Pending SME review"><span aria-hidden="true">⚠</span> Unverified</span></p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-274" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-274" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Keep this value in the mockup review record; no verified Karl field is shown.</li><li>Choose SF.gov page or External link; external entries carry title, URL, and description.</li></ol><div class="karl-guide-values"><h4>Copy visible values</h4><div class="karl-guide-value"><div><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>With file badge</code></div><button type="button" class="karl-guide-copy" data-karl-copy="With file badge" aria-label="Copy Title">Copy</button></div><div class="karl-guide-value"><div><strong>URL</strong><span class="karl-guide-value-source">visible</span><code>https://example.gov/doc.pdf</code></div><button type="button" class="karl-guide-copy" data-karl-copy="https://example.gov/doc.pdf" aria-label="Copy URL">Copy</button></div></div></div></span><h3><a href="https://example.gov/doc.pdf" target="_blank" rel="noopener">With file badge <span aria-hidden="true">↗</span></a></h3></article></div>"`;

exports[`renderCards / renderCardList: shared assembly does not change output renderResourcesList (wraps renderCardList) output for the same card set 1`] = `"<div class="resources-list"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-275" aria-label="Open Karl guide: Resources links list"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Resources links list</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-275" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">E1 confirmed</span></div><ol class="karl-guide-steps"><li>Open Karl admin → Pages → Add child page → Agency.</li><li>Open Content and follow: Content → Section title 2 → Subsection.</li><li>Choose SF.gov page or External link; external entries carry title, URL, and description.</li></ol><p class="karl-guide-path"><strong>Path:</strong> <span>Content → Section title 2 → Subsection</span></p></div></span><ul><li><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-276" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><div id="karl-guide-276" class="karl-guide-panel" hidden><div class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></div><ol class=