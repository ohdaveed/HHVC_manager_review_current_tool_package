exports[`renderCards / renderCardList: shared assembly does not change output renderCards output for a representative card set 1`] = `"<div class="cards"><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-281" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-281" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose SF.gov page or External link; external entries carry title, URL, and description.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>External</code></span><button type="button" class="karl-guide-copy" data-karl-copy="External" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An external link.</code></span><button type="button" class="karl-guide-copy" data-karl-copy="An external link." aria-label="Copy Description">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>URL</strong><span class="karl-guide-value-source">visible</span><code>https://example.gov/page</code></span><button type="button" class="karl-guide-copy" data-karl-copy="https://example.gov/page" aria-label="Copy URL">Copy</button></span></span></span></span><h3><a href="https://example.gov/page" target="_blank" rel="noopener">External <span aria-hidden="true">↗</span></a></h3><p>An external link.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-282" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-282" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose an SF.gov page; Karl supplies the destination title and link.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Internal</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Internal" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>An internal link.</code></span><button type="button" class="karl-guide-copy" data-karl-copy="An internal link." aria-label="Copy Description">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>SF.gov page to choose</strong><span class="karl-guide-value-source">derived</span><code>Healthy Housing and Vector Control</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Healthy Housing and Vector Control" aria-label="Copy SF.gov page to choose">Copy</button></span></span></span></span><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Internal</button></h3><p>An internal link.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-283" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-283" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose an SF.gov page; Karl supplies the destination title and link.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Inert</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Inert" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>No target or url at all.</code></span><button type="button" class="karl-guide-copy" data-karl-copy="No target or url at all." aria-label="Copy Description">Copy</button></span></span></span></span><h3><button type="button" class="inline-link" data-render-inert="">Inert</button></h3><p>No target or url at all.</p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-284" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-284" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose an SF.gov page; Karl supplies the destination title and link.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>Unverified</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Unverified" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Description</strong><span class="karl-guide-value-source">visible</span><code>Needs confirming.</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Needs confirming." aria-label="Copy Description">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>SF.gov page to choose</strong><span class="karl-guide-value-source">derived</span><code>Healthy Housing and Vector Control</code></span><button type="button" class="karl-guide-copy" data-karl-copy="Healthy Housing and Vector Control" aria-label="Copy SF.gov page to choose">Copy</button></span></span></span></span><h3><button type="button" class="inline-link" data-render-target="pestsTopic">Unverified</button></h3><p>Needs confirming.<span class="unverified-pill" title="Pending SME review"><span aria-hidden="true">⚠</span> Unverified</span></p></article><article class="card"><span class="karl-guide" data-karl-guide><button type="button" class="karl-guide-trigger" aria-expanded="false" aria-controls="karl-guide-285" aria-label="Open Karl guide: Linked page item: title + description + link"><mark class="karl-tag" data-kind="placement" data-category="inherited" aria-hidden="true"><span class="karl-tag-kind">Placement</span><span class="karl-tag-text"><strong>Karl:</strong> <span class="karl-tag-headline">Linked page item: title + description + link</span><span class="karl-tag-rationale">Use Related section, body link, Resource Collection item, or Agency page link section as appropriate.</span></span></mark><span class="karl-guide-trigger-icon" aria-hidden="true">+</span></button><span id="karl-guide-285" class="karl-guide-panel" role="group" hidden><span class="karl-guide-panel-header"><strong>Recreate in Karl</strong><span class="karl-guide-status">Mockup only</span></span><span class="karl-guide-steps" role="list"><span role="listitem">Open Karl admin → Pages → Add child page → Agency.</span><span role="listitem">Keep this value in the mockup review record; no verified Karl field is shown.</span><span role="listitem">Choose SF.gov page or External link; external entries carry title, URL, and description.</span></span><span class="karl-guide-values"><span class="karl-guide-values-heading" role="heading" aria-level="4">Copy visible values</span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>Title</strong><span class="karl-guide-value-source">visible</span><code>With file badge</code></span><button type="button" class="karl-guide-copy" data-karl-copy="With file badge" aria-label="Copy Title">Copy</button></span><span class="karl-guide-value"><span class="karl-guide-value-body"><strong>URL</strong><span class="karl-guide-value-source">visible</span><code>https://example.gov/doc.pdf</code></span><button type="button" class="karl-guide-copy" data-karl-copy="https://example.gov/doc.pdf" aria-label="Copy URL">Copy</button></span><